# Copy to .gemini/env and fill in for your machine. Loaded by bin/gemini-sandbox.
#
# (This lives under .gemini/, not the repo root .env -- that file belongs to Symfony's own
# configuration convention and isn't the right place for gemini-sandbox settings.)

# Absolute path to your local ai-intake-mcp checkout (the repo that has dist/index.js).
# ~/.config/ai-intake-mcp is not listed here -- it's always $HOME/.config/ai-intake-mcp by that
# project's own convention, so bin/gemini-sandbox derives it instead of asking you to repeat it.
AI_INTAKE_MCP_DIR=/path/to/your/ai-intake-mcp
